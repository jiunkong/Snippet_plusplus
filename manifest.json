{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "2.0.0",
  "description": "__MSG_app_description__",
  "default_locale": "ko",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "downloads"
  ],
  "background": {
    "service_worker": "bundles/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css",
        "styles/prompt.css"
      ],
      "js": [
        "bundles/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_locales/en/messages.json",
        "_locales/ko/messages.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Snippet++ Options",
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
